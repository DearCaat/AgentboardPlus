#!/bin/sh
set -eu

configured_scanner=$(git config --get gitleaks.binary || true)
scanner=${GITLEAKS_BIN:-${configured_scanner:-gitleaks}}
private_config=$(git config --get gitleaks.config || true)
require_noreply=$(git config --bool --get agentboard.requireNoreply || true)

if ! command -v "$scanner" >/dev/null 2>&1; then
  echo 'Gitleaks is unavailable. See the README to enable local scanning.' >&2
  if [ -n "$configured_scanner" ] || [ -n "$private_config" ]; then exit 1; fi
  exit 0
fi

is_missing_oid() {
  case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

while read -r local_ref local_oid remote_ref remote_oid; do
  if is_missing_oid "$local_oid"; then
    continue
  fi

  # Inspect every commit being uploaded, including history carried by new refs.
  revision="$local_oid"
  if ! is_missing_oid "$remote_oid" && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    revision="$remote_oid..$local_oid"
  fi

  if [ "$require_noreply" = true ]; then
    if ! git log --format='%ae%n%ce' "$revision" | awk 'tolower($0) !~ /@users[.]noreply[.]github[.]com$/ { invalid = 1 } END { exit invalid }'; then
      echo 'An outgoing commit contains a non-noreply author or committer address.' >&2
      exit 1
    fi
  fi

  set -- git --redact=100 --max-decode-depth=2 --log-opts="--full-history -m $revision"
  if [ -n "$private_config" ]; then set -- "$@" --config "$private_config"; fi
  "$scanner" "$@" . < /dev/null
done
